<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Tatiana & Paulo · 17 Abril 2027</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: #000;
            font-family: Arial, sans-serif;
        }

        /* Ecrã de capa inicial */
        #start-screen {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 10;
        }

        /* Imagem de capa em ecrã inteiro */
        .cover-image {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
            z-index: 1;
        }

        /* Camada escura para destacar o botão */
        .cover-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.4);
            z-index: 2;
        }

        /* Botão estilizado */
        .start-btn {
            position: relative;
            z-index: 3;
            background: rgba(0, 0, 0, 0.6);
            color: #fff;
            border: 2px solid #fff;
            padding: 16px 36px;
            font-size: 18px;
            letter-spacing: 3px;
            cursor: pointer;
            transition: all 0.3s ease;
            text-transform: uppercase;
            backdrop-filter: blur(4px);
        }

        .start-btn:hover {
            background-color: #fff;
            color: #000;
        }

        /* Contentor do vídeo */
        .video-container {
            position: relative;
            width: 100vw;
            height: 100vh;
            overflow: hidden;
            display: none;
            justify-content: center;
            align-items: center;
        }

        /* Adaptação para o YouTube Short (Vertical / 9:16) em Ecrã Inteiro */
        .video-container iframe {
            position: absolute;
            top: 50%;
            left: 50%;
            width: 100vw;
            height: 177.77vw;
            min-height: 100vh;
            min-width: 56.25vh;
            transform: translate(-50%, -50%);
            border: none;
            pointer-events: none;
        }
    </style>
</head>
<body>

    <!-- Ecrã inicial com imagem de capa e botão -->
    <div id="start-screen">
        <img class="cover-image" src="https://raw.githubusercontent.com/gui1994-code/wed/99a1521db6d66648bd1ee765666f43d6b6fabc22/1031-Cover.jpg?token=GHSAT0AAAAAAEOTCD6U7SHW3X6SC6VXH2YG2XHNOBA" alt="Capa">
        <div class="cover-overlay"></div>
        <button class="start-btn" onclick="startExperience()">Press to start</button>
    </div>

    <!-- Contentor do Vídeo -->
    <div class="video-container" id="videoContainer">
        <iframe id="youtubePlayer" src="" allow="autoplay"></iframe>
    </div>

    <script>
        function startExperience() {
            // Esconde a capa
            document.getElementById('start-screen').style.display = 'none';
            
            // Mostra o vídeo
            document.getElementById('videoContainer').style.display = 'flex';
            
            // Ativa o vídeo do YouTube com som
            const videoId = 'jCr-8ANDsbM';
            const iframe = document.getElementById('youtubePlayer');
            iframe.src = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&mute=0&loop=1&playlist=${videoId}&controls=0&showinfo=0&rel=0&modestbranding=1`;
        }
    </script>

</body>
</html>
