<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Tatiana & Paulo · 17 Abril 2027</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: #000;
            font-family: Arial, sans-serif;
        }

        /* Ecrã de capa inicial com a imagem */
        #start-screen {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 10;
        }

        .cover-image {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
            z-index: 1;
        }

        .cover-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.4);
            z-index: 2;
        }

        .start-btn {
            position: relative;
            z-index: 3;
            background: rgba(0, 0, 0, 0.6);
            color: #fff;
            border: 2px solid #fff;
            padding: 16px 36px;
            font-size: 18px;
            letter-spacing: 3px;
            cursor: pointer;
            transition: all 0.3s ease;
            text-transform: uppercase;
            backdrop-filter: blur(4px);
        }

        .start-btn:hover {
            background-color: #fff;
            color: #000;
        }

        /* Contentor do vídeo nativo */
        .video-container {
            position: relative;
            width: 100vw;
            height: 100vh;
            overflow: hidden;
            display: none; /* Oculto até clicar */
            background-color: #000;
        }

        /* Faz o vídeo preencher o ecrã inteiro adaptando-se perfeitamente */
        .video-container video {
            position: absolute;
            top: 50%;
            left: 50%;
            min-width: 100%;
            min-height: 100%;
            width: auto;
            height: auto;
            transform: translate(-50%, -50%);
            object-fit: cover;
        }
    </style>
</head>
<body>

    <!-- Ecrã inicial com imagem de capa e botão -->
    <div id="start-screen">
        <img class="cover-image" src="https://raw.githubusercontent.com/gui1994-code/wed/99a1521db6d66648bd1ee765666f43d6b6fabc22/1031-Cover.jpg" alt="Capa">
        <div class="cover-overlay"></div>
        <button class="start-btn" onclick="startExperience()">Press to start</button>
    </div>

    <!-- Contentor do Vídeo Nativo (.mp4) -->
    <div class="video-container" id="videoContainer">
        <video id="bgVideo" playsinline loop preload="auto">
            <source src="https://tats-e-paulo.pt/1031.mp4" type="video/mp4">
            O seu navegador não suporta vídeos.
        </video>
    </div>

    <script>
        function startExperience() {
            // Esconde a capa
            document.getElementById('start-screen').style.display = 'none';
            
            // Mostra o contentor do vídeo
            const container = document.getElementById('videoContainer');
            container.style.display = 'block';
            
            // Ativa o som e inicia a reprodução do vídeo
            const video = document.getElementById('bgVideo');
            video.muted = false; 
            video.play().catch(error => {
                console.log("Erro ao reproduzir o vídeo:", error);
            });
        }
    </script>

</body>
</html>
